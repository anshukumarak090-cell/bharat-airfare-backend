# Copy this file to .env and fill in your real key. Never commit .env.
FLIGHT_API_KEY=your_flightapi_io_key_here

# How often to fetch fresh fares, in minutes. FlightAPI.io free-tier credits
# are limited, so keep this realistic: routes x (60/INTERVAL) = calls per hour.
FETCH_INTERVAL_MINUTES=30

# Port the server listens on (Render/Railway set this automatically in prod)
PORT=3000

# Comma-separated list of routes to track, format FROM-TO (IATA codes)
TRACKED_ROUTES=DEL-BOM,DEL-BLR,BOM-GOI,DEL-GOI,BLR-MAA,DEL-CCU,BOM-BLR,DEL-HYD
